{
  "name": "ai-context-tools",
  "displayName": "AI Context Tools",
  "description": "Copy TODO prompts and code references for AI coding agents.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.78.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-context-tools.copyTodoPrompt",
        "title": "Copy TODO as AI Prompt",
        "category": "AI Context Tools"
      },
      {
        "command": "ai-context-tools.copyFileReference",
        "title": "Copy File Path and Line",
        "category": "AI Context Tools"
      }
    ],
    "menus": {
      "editor/lineNumber/context": [
        {
          "command": "ai-context-tools.copyFileReference",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "AI Context Tools",
      "properties": {
        "ai-context-tools.promptTemplate": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "아래 파일과 줄에 있는 TODO의 지시사항을 수행하세요.\n해당 위치와 주변 코드를 확인하고, 기존 구조와 스타일을 유지하면서 필요한 범위만 수정하세요.\n\n{file}:L{line}\n\n{todo}\n\n수정 후 변경 사항에 적합한 검증을 수행하세요.\nTODO의 지시사항을 모두 완료했다면 해당 TODO 주석을 삭제하세요. 코드 뒤에 붙은 주석이라면 코드 자체는 유지하세요.\n작업이 미완료되었거나 추가 확인이 필요하다면 TODO를 유지하고 남은 사항을 설명하세요.\n완료 후 변경 내용과 검증 결과를 간략히 알려주세요.",
          "markdownDescription": "AI task prompt template. Supports `{file}`, `{line}` (1-based), and `{todo}`.",
          "scope": "resource"
        },
        "ai-context-tools.pathFormat": {
          "type": "string",
          "enum": [
            "absolute",
            "relative"
          ],
          "default": "absolute",
          "description": "Reference path format. Relative paths use the containing workspace folder; files outside the workspace use absolute paths.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.78.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
