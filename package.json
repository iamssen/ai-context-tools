{
  "name": "ai-context-tools",
  "displayName": "AI Context Tools",
  "description": "Turn TODO comments into ready-to-paste prompts for AI coding agents (Claude Code, Codex, Copilot, Cursor) and copy path:line references in one click.",
  "version": "0.0.3",
  "publisher": "iamssen",
  "author": {
    "name": "SSen"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1b2e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamssen/ai-context-tools.git"
  },
  "bugs": {
    "url": "https://github.com/iamssen/ai-context-tools/issues"
  },
  "homepage": "https://github.com/iamssen/ai-context-tools#readme",
  "keywords": [
    "ai",
    "prompt",
    "todo",
    "codelens",
    "claude",
    "claude code",
    "codex",
    "copilot",
    "cursor",
    "chatgpt",
    "agent",
    "llm",
    "copy path",
    "line number",
    "context"
  ],
  "engines": {
    "vscode": "^1.78.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-context-tools.copyTodoPrompt",
        "title": "Copy TODO as AI Prompt",
        "category": "AI Context Tools"
      },
      {
        "command": "ai-context-tools.copyFileReference",
        "title": "Copy Path and Line",
        "category": "AI Context Tools"
      }
    ],
    "menus": {
      "editor/lineNumber/context": [
        {
          "command": "ai-context-tools.copyFileReference",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "AI Context Tools",
      "properties": {
        "ai-context-tools.promptTemplate": {
          "type": "string",
          "editPresentation": "multilineText",
          "default": "",
          "markdownDescription": "AI task prompt template. Supports `{file}`, `{line}` (1-based), and `{todo}`. Leave empty to use the built-in prompt, which follows the editor display language (Korean for `ko`, English otherwise).",
          "scope": "resource"
        },
        "ai-context-tools.pathFormat": {
          "type": "string",
          "enum": [
            "absolute",
            "relative"
          ],
          "default": "absolute",
          "description": "Reference path format. Relative paths use the containing workspace folder; files outside the workspace use absolute paths.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package",
    "publish:ovsx": "ovsx publish --packagePath $npm_package_name-$npm_package_version.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.78.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "ovsx": "1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "tm-grammars": "^1.32.22",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
